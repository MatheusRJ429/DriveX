@page "/veiculos"

@using DriveX.Model
@using DriveX.DAO

@inject VeiculoDAO VeiculoDAO

<PageTitle>Veículos - DriveX</PageTitle>

<div class="page-title">
    <span class="eyebrow">CADASTRO E CONTROLE</span>
    <h1>Veículos</h1>
    <p>Consulte e cadastre os automóveis da frota.</p>
</div>

<button class="btn btn-primary mb-3" @onclick="AbrirFormulario">
    <i class="bi bi-plus-lg"></i>
    Novo veículo
</button>

@if (mostrarFormulario)
{
    <div class="card p-4 mb-4 shadow-sm">
        <h4 class="mb-3">Cadastrar novo veículo</h4>

        <form @onsubmit="SalvarVeiculo" @onsubmit:preventDefault>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label>Marca</label>
                    <input class="form-control" @bind="novoVeiculo.Marca" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Modelo</label>
                    <input class="form-control" @bind="novoVeiculo.Modelo" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Placa</label>
                    <input class="form-control" @bind="novoVeiculo.Placa" required />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Ano</label>
                    <input type="number" class="form-control" @bind="novoVeiculo.Ano" required />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Categoria</label>
                    <input class="form-control" @bind="novoVeiculo.Categoria" placeholder="SUV, Sedan..." required />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Cor</label>
                    <input class="form-control" @bind="novoVeiculo.Cor" required />
                </div>

                <div class="col-md-3 mb-3">
                    <label>Quilometragem</label>
                    <input type="number" class="form-control" @bind="novoVeiculo.Quilometragem" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Preço à vista</label>
                    <input type="number" step="0.01" class="form-control" @bind="novoVeiculo.PrecoVista" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Entrada</label>
                    <input type="number" step="0.01" class="form-control" @bind="novoVeiculo.Entrada" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Parcelas</label>
                    <input class="form-control" @bind="novoVeiculo.Parcelas" placeholder="48x R$ 1.000,00" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label>Status</label>

                    <select class="form-select" @bind="novoVeiculo.Status">
                        <option value="disponivel">Disponível</option>
                        <option value="manutencao">Manutenção</option>
                        <option value="vendido">Vendido</option>
                    </select>
                </div>
            </div>

            <button class="btn btn-success" type="submit">
                <i class="bi bi-check-lg"></i>
                Salvar veículo
            </button>

            <button class="btn btn-secondary ms-2" type="button" @onclick="FecharFormulario">
                Cancelar
            </button>
        </form>
    </div>
}

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="alert alert-success">
        @mensagem
    </div>
}

<div class="card p-4 shadow-sm">
    <input class="form-control mb-3"
           placeholder="Buscar por marca, modelo ou placa..."
           @bind="busca" />

    <table class="table">
        <thead>
            <tr>
                <th>VEÍCULO</th>
                <th>PLACA</th>
                <th>CATEGORIA</th>
                <th>ANO</th>
                <th>STATUS</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var veiculo in VeiculosFiltrados)
            {
                <tr>
                    <td>@veiculo.NomeCompleto</td>
                    <td>@veiculo.Placa</td>
                    <td>@veiculo.Categoria</td>
                    <td>@veiculo.Ano</td>
                    <td>
                        <span class="status-badge">@veiculo.Status</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    // Lista que recebe todos os veículos buscados no banco de dados.
    private List<Veiculo> veiculos = new();

    // Objeto que guarda os dados digitados no formulário de cadastro.
    // O status inicial do novo veículo será "disponivel".
    private Veiculo novoVeiculo = new()
    {
        Status = "disponivel"
    };

    // Controla se o formulário de cadastro aparece ou fica escondido.
    private bool mostrarFormulario = false;

    // Guarda a mensagem de sucesso após cadastrar um veículo.
    private string mensagem = string.Empty;

    // Guarda o texto digitado no campo de busca.
    private string busca = string.Empty;

    // Método executado automaticamente quando a página é aberta.
    protected override void OnInitialized()
    {
        // Busca todos os veículos cadastrados no banco.
        CarregarVeiculos();
    }

    // Chama o VeiculoDAO para buscar os veículos no banco de dados.
    private void CarregarVeiculos()
    {
        veiculos = VeiculoDAO.Listar();
    }

    // Abre o formulário quando o botão "Novo veículo" é clicado.
    private void AbrirFormulario()
    {
        // Limpa uma possível mensagem anterior.
        mensagem = string.Empty;

        // Faz o formulário aparecer.
        mostrarFormulario = true;
    }

    // Fecha o formulário e limpa os campos preenchidos.
    private void FecharFormulario()
    {
        // Esconde o formulário.
        mostrarFormulario = false;

        // Cria um novo objeto vazio para limpar os campos.
        novoVeiculo = new Veiculo
        {
            Status = "disponivel"
        };
    }

    // Salva os dados do novo veículo no banco de dados.
    private void SalvarVeiculo()
    {
        // Envia o objeto preenchido para o método Adicionar do VeiculoDAO.
        VeiculoDAO.Adicionar(novoVeiculo);

        // Busca novamente os veículos para atualizar a tabela da página.
        CarregarVeiculos();

        // Define a mensagem de confirmação.
        mensagem = "Veículo cadastrado com sucesso.";

        // Fecha o formulário e limpa os campos.
        FecharFormulario();
    }

    // Cria uma lista filtrada conforme o texto digitado no campo de busca.
    private IEnumerable<Veiculo> VeiculosFiltrados =>
        veiculos.Where(v =>

            // Procura o texto digitado na marca do veículo.
            v.Marca.Contains(busca, StringComparison.OrdinalIgnoreCase) ||

            // Procura o texto digitado no modelo do veículo.
            v.Modelo.Contains(busca, StringComparison.OrdinalIgnoreCase) ||

            // Procura o texto digitado na placa do veículo.
            v.Placa.Contains(busca, StringComparison.OrdinalIgnoreCase));
}