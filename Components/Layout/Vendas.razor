@page "/vendas"
@inject VendaDAO VendaDAO

<PageTitle>Vendas | DriveX</PageTitle>

<div class="welcome-row">
    <div>
        <p class="section-label">VENDAS</p>
        <h1>Histórico de vendas</h1>
        <p class="text-secondary">Vendas registradas pela concessionária.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-warning mt-4">@mensagemErro</div>
}

<div class="card mt-4 shadow-sm border-0">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>VENDA</th>
                        <th>CLIENTE</th>
                        <th>CARRO</th>
                        <th>DATA</th>
                        <th>VALOR</th>
                        <th>PAGAMENTO</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var venda in vendas)
                    {
                        <tr>
                            <td>#@venda.Id</td>
                            <td>Cliente #@venda.IdCliente</td>
                            <td>Carro #@venda.IdCarro</td>
                            <td>@venda.DataVenda.ToString("dd/MM/yyyy")</td>
                            <td>R$ @venda.ValorVenda.ToString("N2")</td>
                            <td>@venda.FormaPagamento</td>
                            <td><span class="status-badge">@venda.StatusVenda</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Venda> vendas = [];
    private string? mensagemErro;

    protected override void OnInitialized()
    {
        try
        {
            vendas = VendaDAO.Listar();
        }
        catch
        {
            mensagemErro = "Não foi possível carregar as vendas.";
        }
    }
}