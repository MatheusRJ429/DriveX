@page "/"
@inject VeiculoDAO VeiculoDAO

<div class="title-row"><div><p class="eyebrow">PAINEL PRINCIPAL</p><h1>Olá, Rafael! <span>👋</span></h1><p class="muted">Acompanhe o desempenho da sua frota hoje.</p></div><button class="outline-button">↗ Exportar relatório</button></div>

<div class="stats-grid">
    <article class="stat-card blue"><div><p>Total de veículos</p><strong>@VeiculoDAO.Listar().Count</strong><span class="positive">↑ 12% <em>vs. mês anterior</em></span></div><b>▣</b></article>
    <article class="stat-card green"><div><p>Em operação</p><strong>2</strong><span class="positive">↑ 8% <em>vs. mês anterior</em></span></div><b>↗</b></article>
    <article class="stat-card amber"><div><p>Em manutenção</p><strong>1</strong><span class="negative">↓ 4% <em>vs. mês anterior</em></span></div><b>⚒</b></article>
    <article class="stat-card purple"><div><p>Quilometragem média</p><strong>38.420 <small>km</small></strong><span class="positive">↑ 6% <em>vs. mês anterior</em></span></div><b>⌁</b></article>
</div>

<div class="dashboard-grid">
    <section class="panel chart-panel"><div class="panel-head"><div><h2>Utilização da frota</h2><p>Veículos ativos nos últimos 6 meses</p></div><select aria-label="Período"><option>Últimos 6 meses</option></select></div><div class="chart"><div class="ylabels"><span>100%</span><span>75%</span><span>50%</span><span>25%</span><span>0%</span></div><div class="chart-lines"><svg viewBox="0 0 620 230" preserveAspectRatio="none" aria-label="Gráfico de utilização"><defs><linearGradient id="fill" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#2878d4" stop-opacity=".24"/><stop offset="1" stop-color="#2878d4" stop-opacity="0"/></linearGradient></defs><path d="M0,177 C45,160 67,130 110,138 S178,113 217,120 S277,75 322,90 S390,48 431,64 S501,31 548,48 S592,22 620,31 L620,230 L0,230Z" fill="url(#fill)"/><path d="M0,177 C45,160 67,130 110,138 S178,113 217,120 S277,75 322,90 S390,48 431,64 S501,31 548,48 S592,22 620,31" fill="none" stroke="#2878d4" stroke-width="4"/></svg><div class="months"><span>Abr</span><span>Mai</span><span>Jun</span><span>Jul</span><span>Ago</span><span>Set</span></div></div></div></section>
    <section class="panel maintenance"><div class="panel-head"><div><h2>Próximas manutenções</h2><p>Serviços agendados para esta semana</p></div><a href="/veiculos">Ver todos →</a></div><div class="maintenance-list"><div><span class="dot orange"></span><p><strong>Fiat Strada</strong><small>Revisão preventiva · 15 Set</small></p><b>Hoje</b></div><div><span class="dot blue-dot"></span><p><strong>Toyota Corolla</strong><small>Troca de óleo · 18 Set</small></p><b class="date">18 Set</b></div><div><span class="dot purple-dot"></span><p><strong>Chevrolet Onix</strong><small>Alinhamento · 20 Set</small></p><b class="date">20 Set</b></div></div></section>
</div>

<section class="panel vehicles-preview"><div class="panel-head"><div><h2>Veículos recentes</h2><p>Últimos veículos atualizados</p></div><a href="/veiculos">Ver frota completa →</a></div><div class="vehicle-cards">@foreach (var v in VeiculoDAO.Listar().Take(3)){<article class="vehicle-card"><div class="car-illustration" style="--car:@v.Cor"><span>▰</span></div><h3>@v.Modelo</h3><p>@v.Placa · @v.Ano</p><span class="status @v.Status.Replace(" ", "").ToLowerInvariant()">@v.Status</span></article>}</div></section>
