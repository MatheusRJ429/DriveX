@page "/veiculos"
@inject VeiculoDAO VeiculoDAO

<div class="title-row"><div><p class="eyebrow">CADASTRO E CONTROLE</p><h1>Veículos</h1><p class="muted">Gerencie todos os veículos da sua frota.</p></div><button class="primary-button" @onclick="AbrirCadastro">+ Adicionar veículo</button></div>
@if (mostrarCadastro)
{
    <section class="panel add-form"><h2>Novo veículo</h2><div class="form-grid"><input placeholder="Modelo (ex.: Honda Civic)" @bind="novo.Modelo" /><input placeholder="Placa" @bind="novo.Placa" /><input placeholder="Categoria" @bind="novo.Categoria" /><input type="number" placeholder="Ano" @bind="novo.Ano" /></div><div class="form-actions"><button class="outline-button" @onclick="FecharCadastro">Cancelar</button><button class="primary-button" @onclick="Salvar">Salvar veículo</button></div></section>
}
<section class="panel table-panel"><div class="filters"><div class="search">⌕ <input @bind="busca" placeholder="Buscar por modelo ou placa..." /></div><select @bind="filtro"><option value="Todos">Todos os status</option><option>Disponível</option><option>Em uso</option><option>Manutenção</option></select></div><div class="table-wrap"><table><thead><tr><th>VEÍCULO</th><th>PLACA</th><th>CATEGORIA</th><th>ANO</th><th>STATUS</th><th></th></tr></thead><tbody>@foreach(var v in VeiculosFiltrados){<tr><td><div class="table-car" style="--car:@v.Cor">▰</div><strong>@v.Modelo</strong></td><td>@v.Placa</td><td>@v.Categoria</td><td>@v.Ano</td><td><span class="status @v.Status.Replace(" ", "").ToLowerInvariant()">@v.Status</span></td><td><button class="more">•••</button></td></tr>}</tbody></table></div></section>

@code { private string busca = string.Empty; private string filtro = "Todos"; private bool mostrarCadastro; private Veiculo novo = new() { Status = "Disponível", Ano = DateTime.Now.Year, Cor = "#2878d4" }; private IEnumerable<Veiculo> VeiculosFiltrados => VeiculoDAO.Listar().Where(v => (filtro == "Todos" || v.Status == filtro) && (string.IsNullOrWhiteSpace(busca) || v.Modelo.Contains(busca, StringComparison.OrdinalIgnoreCase) || v.Placa.Contains(busca, StringComparison.OrdinalIgnoreCase))); private void AbrirCadastro() => mostrarCadastro = true; private void FecharCadastro() => mostrarCadastro = false; private void Salvar(){ if (!string.IsNullOrWhiteSpace(novo.Modelo) && !string.IsNullOrWhiteSpace(novo.Placa)){ VeiculoDAO.Adicionar(novo); novo = new() { Status = "Disponível", Ano = DateTime.Now.Year, Cor = "#2878d4" }; mostrarCadastro = false; } } }
