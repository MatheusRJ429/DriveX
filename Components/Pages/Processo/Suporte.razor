@page "/chamados"

@using DriveX.DAO
@using DriveX.Model

@inject ChamadoSuporteDAO ChamadoSuporteDAO

<PageTitle>Chamados | DriveX</PageTitle>

<div class="welcome-row">
    <div>
        <p class="section-label">SUPORTE</p>
        <h1>Chamados de suporte</h1>
        <p class="text-secondary">Solicitações enviadas pelos clientes.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-warning mt-4">@mensagemErro</div>
}

<div class="card mt-4 shadow-sm border-0">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>CLIENTE</th>
                        <th>TIPO</th>
                        <th>MENSAGEM</th>
                        <th>DATA</th>
                        <th>STATUS</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var chamado in chamados)
                    {
                        <tr>
                            <td>@chamado.NomeCliente</td>
                            <td>@chamado.TipoSuporte</td>
                            <td>@chamado.Mensagem</td>
                            <td>@(chamado.DataChamado?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>
                                <span class="status-badge">@chamado.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    // Lista que guarda todos os chamados de suporte trazidos do banco.
    private List<ChamadoSuporte> chamados = [];

    // Guarda a mensagem mostrada caso ocorra algum erro.
    private string? mensagemErro;

    // Método executado automaticamente quando a página é aberta.
    protected override void OnInitialized()
    {
        try
        {
            // Chama o método Listar do ChamadoSuporteDAO.
            // Esse método faz uma consulta no banco e devolve os chamados.
            chamados = ChamadoSuporteDAO.Listar();
        }
        catch
        {
            // Caso dê erro de conexão ou consulta no banco,
            // esta mensagem aparecerá no alerta amarelo da página.
            mensagemErro = "Não foi possível carregar os chamados.";
        }
    }
}