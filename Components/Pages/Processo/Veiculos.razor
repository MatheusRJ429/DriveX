@page "/veiculos"
@inject VeiculoDAO VeiculoDAO

<PageTitle>Veículos | DriveX</PageTitle>
<div class="welcome-row"><div><p class="section-label">CADASTRO E CONTROLE</p><h1>Veículos</h1><p class="text-secondary">Consulte os automóveis cadastrados na frota.</p></div><button class="btn btn-primary" disabled><i class="bi bi-plus-lg me-1"></i> Novo veículo</button></div>
@if (!string.IsNullOrEmpty(mensagemErro)) { <div class="alert alert-warning mt-4">@mensagemErro</div> }
<div class="card mt-4 shadow-sm border-0"><div class="card-body p-4"><div class="row g-3 mb-4"><div class="col-md-8"><input class="form-control" @bind="busca" placeholder="Buscar por modelo, marca ou placa..." /></div><div class="col-md-4"><select class="form-select" @bind="filtro"><option>Todos</option><option>Disponível</option><option>Em uso</option><option>Manutenção</option></select></div></div><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>VEÍCULO</th><th>PLACA</th><th>CATEGORIA</th><th>ANO</th><th>STATUS</th></tr></thead><tbody>@foreach(var v in filtrados){<tr><td><i class="bi bi-car-front text-primary me-2"></i><strong>@v.Marca @v.Modelo</strong></td><td>@v.Placa</td><td>@v.Categoria</td><td>@v.Ano</td><td><span class="status-badge">@v.Status</span></td></tr>}</tbody></table></div></div></div>
@code { private List<Veiculo> veiculos = []; private string busca = ""; private string filtro = "Todos"; private string? mensagemErro; private IEnumerable<Veiculo> filtrados => veiculos.Where(v => (filtro == "Todos" || v.Status == filtro) && ($"{v.Marca} {v.Modelo} {v.Placa}".Contains(busca, StringComparison.OrdinalIgnoreCase))); protected override void OnInitialized(){try { veiculos = VeiculoDAO.Listar(); } catch { mensagemErro = "Confira a conexão com o banco e a tabela veiculos."; }} }
